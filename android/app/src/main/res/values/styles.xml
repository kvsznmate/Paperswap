<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown for the moment before Compose draws its first frame. Matches the
         Paper ground colour (ADR-013), so a light-mode launch does not flash
         black; values-night/ has the night version. PaperTheme takes over the
         bar colours once it runs. -->
    <style name="Theme.NewsSwipeAndroid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper_ground</item>
        <item name="android:statusBarColor">@color/paper_ground</item>
        <item name="android:navigationBarColor">@color/paper_ground</item>
    </style>

    <color name="paper_ground">#FFF4EFE4</color>
</resources>
