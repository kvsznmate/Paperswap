# NewsAPI Configuration
# Get your free API key at https://newsapi.org/
NEWS_API_KEY=

# --- Admin API key ---
# Required. Guards the endpoints that mutate state or expose operational data:
#   POST /api/v1/cards/refresh
#   GET  /api/v1/telemetry/stats
#   GET  /api/v1/telemetry/logs
# Send it as the header:  X-API-Key: <value>
# Fails CLOSED: if unset, those endpoints return 503 rather than running open.
# Generate one with:  openssl rand -hex 32
ADMIN_API_KEY=

# How long an /analytics browser session stays signed in, in seconds (default 12 h).
# Sessions live in memory, so a container restart signs everyone out regardless.
ADMIN_SESSION_TTL=43200

# Set to true ONLY once HTTPS is terminating in front of the app (Caddy - see
# PROJECT_STATUS.md). A Secure cookie is silently dropped over plain HTTP, which
# looks like "the sign-in form just reloads forever".
ADMIN_COOKIE_SECURE=false

# --- PostgreSQL credentials ---
# Required. docker-compose fails to start if these are unset.
# Generate a strong password with:  openssl rand -base64 24
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=newsdb

# Only needed for local (non-Docker) runs. Under Compose, DATABASE_URL is
# assembled from the three variables above and points at the "db" service.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/newsdb

# --- Topic feed tuning ---
# Articles fetched per topic on each refresh cycle.
# 7 topics (Tech, Finance, Sports, Politics, Programming, Science, Beauty)
# x 12 = 84 candidate articles per batch, before deduplication.
ARTICLES_PER_CATEGORY=12

# Default number of cards returned by GET /api/v1/feed.
FEED_DEFAULT_LIMIT=70

# Hours between automatic background refreshes.
REFRESH_INTERVAL=12

# Articles older than this many days are purged on each refresh.
PURGE_OLDER_THAN_DAYS=7

# Retention for the request_logs analytics table. Leave unset unless you have a
# reason: it defaults to PURGE_OLDER_THAN_DAYS, and it should match.
#
# The hourly-usage and top-endpoint panels UNION request_logs with user_swipes,
# and user_swipes is already capped at the article window by ON DELETE CASCADE.
# Set this higher and the two halves of that union cover different periods --
# swipes then under-represent against every other endpoint, which on the chart
# looks like a real drop in swipe traffic rather than a retention artefact.
# REQUEST_LOG_RETENTION_DAYS=7

# Retention for user_sessions, measured from last_heartbeat (so a live session is
# never purged mid-flight). Also defaults to PURGE_OLDER_THAN_DAYS. Raising it
# makes "total sessions" and "avg time connected" cover a longer period than the
# swipe and article counters shown beside them.
# SESSION_RETENTION_DAYS=7

# Period the reported "avg time connected" covers. Defaults to
# SESSION_RETENTION_DAYS and is CLAMPED to it at startup.
#
# The clamp exists because sessions are purged on last_heartbeat: asking for a
# 30-day average when only 7 days of rows survive computes over those 7 days and
# labels the result "30 days". Setting this ABOVE retention logs a warning and
# falls back. Setting it BELOW is fine and sometimes useful -- e.g. 1 for a
# same-day figure. The window used is echoed back in the telemetry payload as
# avg_session_window_days, so the number never travels without it.
# SESSION_METRIC_WINDOW_DAYS=7

# Seconds between flushes of the in-memory request-log buffer into Postgres.
# The middleware never writes to the database itself; a background job drains
# the buffer on this interval and once more on shutdown. Lower means fresher
# analytics and more INSERTs; higher means more events lost to a hard kill.
LOG_FLUSH_INTERVAL=10
