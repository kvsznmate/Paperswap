# NewsAPI Configuration
# Get your free API key at https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# PostgreSQL connection
# Docker Compose sets this automatically to the "db" service.
# For local (non-Docker) runs, point it at your own Postgres instance:
DATABASE_URL=postgresql://newsuser:newspass@localhost:5432/newsdb

# --- Topic feed tuning ---
# Articles fetched per topic on each refresh cycle.
# 7 topics (Tech, Finance, Sports, Politics, Programming, Science, Beauty)
# x 12 = 84 candidate articles per batch, before deduplication.
ARTICLES_PER_CATEGORY=12

# Default number of cards returned by GET /api/v1/feed.
FEED_DEFAULT_LIMIT=70

# Hours between automatic background refreshes.
REFRESH_INTERVAL=12

# Articles older than this many days are purged on each refresh.
PURGE_OLDER_THAN_DAYS=7
