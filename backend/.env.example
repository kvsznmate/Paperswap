# NewsAPI Configuration
# Get your free API key at https://newsapi.org/
NEWS_API_KEY=

# --- Admin API key ---
# Required. Guards the endpoints that mutate state or expose operational data:
#   POST /api/v1/cards/refresh
#   GET  /api/v1/telemetry/stats
#   GET  /api/v1/telemetry/logs
# Send it as the header:  X-API-Key: <value>
# Fails CLOSED: if unset, those endpoints return 503 rather than running open.
# Generate one with:  openssl rand -hex 32
ADMIN_API_KEY=

# How long an /analytics browser session stays signed in, in seconds (default 12 h).
# Sessions live in memory, so a container restart signs everyone out regardless.
ADMIN_SESSION_TTL=43200

# Set to true ONLY once HTTPS is terminating in front of the app (Caddy - see
# PROJECT_STATUS.md). A Secure cookie is silently dropped over plain HTTP, which
# looks like "the sign-in form just reloads forever".
ADMIN_COOKIE_SECURE=false

# --- PostgreSQL credentials ---
# Required. docker-compose fails to start if these are unset.
# Generate a strong password with:  openssl rand -base64 24
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=newsdb

# Only needed for local (non-Docker) runs. Under Compose, DATABASE_URL is
# assembled from the three variables above and points at the "db" service.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/newsdb

# --- Topic feed tuning ---
# Articles fetched per topic on each refresh cycle.
# 7 topics (Tech, Finance, Sports, Politics, Programming, Science, Beauty)
# x 12 = 84 candidate articles per batch, before deduplication.
ARTICLES_PER_CATEGORY=12

# Default number of cards returned by GET /api/v1/feed.
FEED_DEFAULT_LIMIT=70

# Hours between automatic background refreshes.
REFRESH_INTERVAL=12

# Articles older than this many days are purged on each refresh.
PURGE_OLDER_THAN_DAYS=7
